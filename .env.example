# Copy to .env and set real values. Never commit .env.
# Flex resolves these names from config/pools.yaml (api_base_env/api_key_env)
# and passes the values only to LiteLLM. .env values win over system ENV
# when FLEX_OVERRIDE=1 (see /setup page or config/setup.conf).

# Channel 1: opencode-go-deepseek (primary, free tier)
OPENCODE_GO_API_BASE=https://your-provider-base/v1
OPENCODE_GO_API_KEY=

# Channel 2: sensenova-deepseek (quota-paced, free tier, 450/5h target)
SENSENOVA_API_BASE=https://your-provider-base/v1
SENSENOVA_API_KEY=

# Channel 3: deepseek-official (fallback-only, paid)
DEEPSEEK_OFFICIAL_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_OFFICIAL_API_KEY=

# Optional: force override behavior at boot if config/setup.conf is absent
FLEX_OVERRIDE=1