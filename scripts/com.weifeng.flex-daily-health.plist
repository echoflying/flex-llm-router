<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.weifeng.flex-daily-health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/weifeng/projects/flex-llm-router/.venv/bin/python</string>
        <string>/Users/weifeng/projects/flex-llm-router/scripts/daily_health_check.py</string>
    </array>
    <!-- Run at 3:00 AM daily -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/weifeng/projects/flex-llm-router/logs/daily-health.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/weifeng/projects/flex-llm-router/logs/daily-health.err.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/weifeng/projects/flex-llm-router</string>
</dict>
</plist>
